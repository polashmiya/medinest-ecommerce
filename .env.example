# Copy to .env.local and adjust. Every variable is optional: without any of
# them the store runs on the bundled mock catalog and browser storage.

# Public URL of the site (canonical links, sitemap, structured data, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Catalog backend -------------------------------------------------------
# Point at an API that implements the endpoints listed in
# src/services/catalog/http.ts to replace the mock catalog.
# CATALOG_API_URL=https://api.example.com/v1
# Seconds to cache catalog responses (default 300).
# CATALOG_REVALIDATE_SECONDS=300

# --- Content backend (blog, info pages, lab tests, doctors) ---------------
# CONTENT_API_URL=https://cms.example.com/v1

# --- Product images ---------------------------------------------------------
# Base URL for product photos. Products without photos use generated artwork.
# NEXT_PUBLIC_IMAGE_BASE_URL=https://cdn.example.com

# --- Feature flags (see src/config/features.config.ts) ---------------------
# Set to 0/false to turn a feature off, 1/true to turn it on.
# NEXT_PUBLIC_FEATURE_LAB_TESTS=1
# NEXT_PUBLIC_FEATURE_DOCTOR=1
# NEXT_PUBLIC_FEATURE_COMPARE=0

# --- Build -----------------------------------------------------------------
# Skip Turbopack's build cache where .next/cache isn't kept between builds
# (some CI setups) or when disk space is tight.
# NEXT_BUILD_CACHE=0
